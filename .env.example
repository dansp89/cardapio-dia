# Copie para .env e ajuste. Tudo aqui é opcional: sem .env o projeto usa
# os valores abaixo como padrão.
#
#   cp .env.example .env

# --- Servidor de produção (server.mjs / PM2) ---------------------------------

# Porta escolhida fora das faixas comuns e do range efêmero do Linux
# (32768-60999), para não conflitar com outros serviços da máquina.
PORT=27381

# 0.0.0.0 aceita conexões de fora; use 127.0.0.1 para só aceitar do proxy
# reverso na mesma máquina.
HOST=0.0.0.0

# --- Servidor de desenvolvimento (Vite) --------------------------------------

VITE_DEV_PORT=27382

# Porta do `bun run preview`, que serve o build já compilado.
VITE_PREVIEW_PORT=27384

# Deixe 0.0.0.0 para acessar do celular na mesma rede Wi-Fi.
VITE_DEV_HOST=0.0.0.0

# Domínios autorizados a servir o dev server, separados por vírgula. O Vite
# recusa requisições com Host diferente — proteção contra DNS rebinding.
# Vazio mantém o padrão (localhost e IPs da rede local).
# Exemplos: meuapp.local,dev.meudominio.com.br
VITE_ALLOWED_HOSTS=
