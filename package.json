{
  "name": "cardapio-dia",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Gera um PDF de etiquetas recortáveis com os pratos do dia. Sem backend: o cardápio viaja no próprio link.",
  "license": "MIT",
  "homepage": "https://github.com/dansp89/cardapio-dia#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dansp89/cardapio-dia.git"
  },
  "bugs": {
    "url": "https://github.com/dansp89/cardapio-dia/issues"
  },
  "keywords": [
    "cardapio",
