    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^3.3.11"
  }
